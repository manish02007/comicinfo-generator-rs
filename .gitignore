# Rust build output — can be hundreds of MB, always regenerated by cargo
/target/

# Cargo lock file for binaries: commit this so builds are reproducible.
# (For libraries you'd gitignore it, but for apps keep it.)
# Cargo.lock   ← intentionally NOT ignored

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor temp files
*.swp
*.swo
.vscode/settings.json
.idea/

# Our own autosave (personal, not shared)
.comicinfo_autosave.json

# Log files generated during processing
logs/
